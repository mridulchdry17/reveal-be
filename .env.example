# Copy to .env for local overrides. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://reveal:reveal@localhost:5433/reveal
CORS_ORIGINS=["http://localhost:5173"]

# Admin endpoints (e.g. GET /v1/waitlist/export with header X-Admin-Token). Empty disables them.
ADMIN_TOKEN=
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=[]

# Web Push. Generate once per environment: uv run python scripts/vapid_keys.py
# Empty = no notifications (nothing is queued and the app hides the switch).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-api-host (defaults to the production API URL)
